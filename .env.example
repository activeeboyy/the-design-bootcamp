# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# META PIXEL & CONVERSIONS API (CAPI) CONFIGURATION
# ==============================================================================
# Meta Pixel ID (public identifier, already in website header)
META_PIXEL_ID="1270731831846532"

# Meta Conversions API System User Access Token
# Generated in Meta Business Manager / Events Manager -> Data Sources -> Settings -> Generate Access Token
# CRITICAL: Keep secret. Never expose in frontend code.
META_ACCESS_TOKEN="YOUR_META_CONVERSIONS_API_ACCESS_TOKEN"

# Optional: Meta Test Event Code (from Events Manager -> Test Events tab, e.g. "TEST12345")
# Leave blank in production. Use for live testing in Meta Events Manager.
META_TEST_EVENT_CODE=""

# ==============================================================================
# PAYSTACK PAYMENT VERIFICATION CONFIGURATION
# ==============================================================================
# Paystack Secret Key (from Paystack Dashboard -> Settings -> API Keys & Webhooks)
# Format: sk_live_... (or sk_test_... during development)
# CRITICAL: Keep secret. Server-side only. Used to verify transaction references and webhook signatures.
PAYSTACK_SECRET_KEY="YOUR_PAYSTACK_SECRET_KEY"
